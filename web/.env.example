# Use empty for Vite dev proxy to Laravel (same-origin /api)
VITE_API_URL=
# Vite dev proxy target when VITE_API_URL is empty
# Laragon (repo root vhost; root .htaccess maps /api → Laravel)
# php artisan serve: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://prism.test

# Production (npm run build): copy web/.env.production.example → .env.production
# VITE_API_URL=https://sap-api.innovisiq.com/api

{
  "expo": {
    "name": "EFSC-YA",
    "slug": "EFSC-YA-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.school.EFSC-YA"
    },
    "android": {
      "package": "com.school.EFSC-YA"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}

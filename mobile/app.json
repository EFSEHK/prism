{
  "expo": {
    "name": "EFSC-YA",
    "slug": "EFSC-YA-school",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.school.efscya"
    },
    "android": {
      "package": "com.school.efscya",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://sap-api.innovisiq.com/api"
    }
  }
}

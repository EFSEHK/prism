# Laragon backend (after root .htaccess): login is POST /api/login
EXPO_PUBLIC_API_URL=http://prism.test/api

# Production APK build: copy mobile/.env.production.example values here or use that file
# EXPO_PUBLIC_API_URL=https://sap-api.innovisiq.com/api

# Your PC's Wi‑Fi IP (ipconfig). Required on a real phone so the app can
# reach Laragon (phones cannot resolve prism.test unless you edit hosts).
# Not used in the browser (npm run web) — prism.test works on the dev PC.
EXPO_PUBLIC_API_LAN_IP=192.168.18.15

# Android emulator without LAN_IP (uses Host: prism.test via 10.0.2.2):
# EXPO_PUBLIC_API_URL=http://prism.test/api

# php artisan serve instead of Laragon:
# EXPO_PUBLIC_API_URL=http://192.168.18.15:8000/api

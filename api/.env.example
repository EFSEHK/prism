APP_NAME=EFSC-YA
APP_ENV=development
APP_KEY=
APP_DEBUG=true
# Local Laragon
# APP_URL=http://EFSC-YA.test
# DEFAULT_WEB_APP_URL=http://localhost:5173
# LARAVEL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

# Production (set on server — copy from this file if .env is missing keys)
# APP_URL=https://sap-api.innovisiq.com
# APP_ENV=production
# APP_DEBUG=false
# DEFAULT_WEB_APP_URL=https://sap.innovisiq.com
# LARAVEL_CORS_ALLOWED_ORIGINS=https://sap.innovisiq.com,http://localhost:5173,http://localhost:8081
# SANCTUM_STATEFUL_DOMAINS=sap.innovisiq.com

APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
# LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Must be the Prism database (typically `prism`), never the CMS `cms` DB —
# pointing at the wrong DB causes intermittent "Invalid login details".
DB_DATABASE=prism
DB_USERNAME=
DB_PASSWORD=

ACTIVITY_LOGGER_ENABLED=true
TELESCOPE_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

SANCTUM_TOKEN_EXPIRATION=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

HEALTH_CACHE_STORE=file
HEALTH_SECRET_TOKEN=
HEALTH_NOTIFICATION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# For Auth sanctum - start
# Local dev + production web SPA origin (comma-separated)
LARAVEL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,https://sap.innovisiq.com
LARAVEL_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
LARAVEL_CORS_ALLOWED_HEADERS=Content-Type,X-Requested-With,Authorization,X-CSRF-TOKEN
LARAVEL_CORS_SUPPORTS_CREDENTIALS=true
# Cookie-based SPA auth: include production web host
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,sap.innovisiq.com
# For Auth sanctum - end

# Student/parent login emails: {admission_no|cnic}@{domain}
EFSC_LOGIN_EMAIL_DOMAIN=efsc-ya.com

# Production URLs (used as defaults for welcome page links & release seeder)
PRODUCTION_API_URL=https://sap-api.innovisiq.com
PRODUCTION_WEB_URL=https://sap.innovisiq.com

# Public welcome page — web app link shown on /
# Local: http://localhost:5173  |  Production: https://sap.innovisiq.com
DEFAULT_WEB_APP_URL=https://sap.innovisiq.com
DEV_PORTAL_PATH=sys/portal-access
